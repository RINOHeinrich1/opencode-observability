# Dépendances
node_modules/

# Base de données runtime du panneau (users/sessions/archives) — ne JAMAIS versionner
panel.db
panel.db-shm
panel.db-wal

# Variables d'environnement / secrets
.env
.env.*
!.env.example

# Logs & fichiers temporaires
*.log
npm-debug.log*
.DS_Store

# Dossiers racines de stockage runtime (documents de cadrage, pièces/maquettes/
# rapports de recette) — données runtime, hors versioning (ADR-004, doc 17).
storage/cadrage-docs/
storage/recette-docs/
storage/recette-maquettes/
storage/recette-perf/

# Journal d'audit du script de renommage des racines (données runtime)
storage/.rename-storage-roots/

# Résultats E2E Playwright (runs/vidéos — données runtime)
storage/e2e/

# Artefacts de travail (plans/reports déposés par les agents) — pas versionnés
plans/
reports/
